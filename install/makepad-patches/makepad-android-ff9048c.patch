+            i.putExtra("text", text);
+            if (Build.VERSION.SDK_INT >= 26) startForegroundService(i); else startService(i);
+        } catch (Exception e) {
+            Log.e("Makepad", "startSessionService failed", e);
+        }
+    }
+
+    /// Called when the app is back in front, or the last session ended.
+    public void stopSessionService() {
+        try {
+            stopService(new Intent(this, SessionService.class));
+        } catch (Exception e) {
+            Log.e("Makepad", "stopSessionService failed", e);
+        }
+    }
+
+    @Override
+    protected void onNewIntent(Intent intent) {
+        Log.i("Makepad", "leuwi: onNewIntent");
+        super.onNewIntent(intent);
+        setIntent(intent);
+        captureLeuwiTab(intent);
+    }
+
 }
